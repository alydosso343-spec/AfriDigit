# ============================================================
# AfriDigit — variables d'environnement (exemple)
# Copiez ce fichier en .env.local puis complétez vos valeurs.
#   cp .env.example .env.local
# (il ne faut JAMAIS committer .env.local : il est déjà ignoré par git)
# ============================================================

# --- Administration (obligatoire pour ouvrir l'espace privé) --
# L'adresse et le code sont vérifiés côté serveur uniquement ;
# ils n'apparaissent nulle part sur le site public.
ADMIN_EMAIL=afridigit26@gmail.com
ADMIN_ACCESS_CODE=Afridigit26
ADMIN_SESSION_SECRET=684609d33c2b2de21d4684182ece0ae0f81d88671a78927097184ea363ec2bda
#   > Générer un secret solide :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Boutique -------------------------------------------------
# Devise affichée (XOF => « F CFA ») ; formatage fr-FR automatique.
CURRENCY=XOF
# URL publique du site en production (ex. https://afridigit.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de données & images ---------------------------------
# Laissez ces 3 variables VIDES pour le mode LOCAL (défaut) :
# les produits sont enregistrés dans data/products.json et les
# images dans public/uploads/ — aucune configuration requise.
#
# Renseignez les 3 clés UNIQUEMENT pour passer en mode SUPABASE
# (production) : le site bascule automatiquement sur ce backend.
#   NEXT_PUBLIC_SUPABASE_URL        →  Settings → API
#   NEXT_PUBLIC_SUPABASE_ANON_KEY   →  lecture publique (anon)
#   SUPABASE_SERVICE_ROLE_KEY       →  écritures admin (jamais côté navigateur)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
